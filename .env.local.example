# Supabase — find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Project Settings > API > service_role (secret!)
# Used ONLY in the server-side API route, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com > API Keys
RESEND_API_KEY=
# Must be a verified domain/sender in Resend.
# Use onboarding@resend.dev for testing before the domain below is verified.
RESEND_FROM_EMAIL=info@busybrainstech-hub.com.ng

# Comma-separated list of staff emails who get notified on every new case
STAFF_NOTIFICATION_EMAILS=you@example.com,admin@example.com

# Your deployed site URL (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
